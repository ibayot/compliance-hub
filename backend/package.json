{
    "name": "rictms-backend",
    "version": "0.0.22",
    "description": "RICTMS Compliance Hub - Backend API",
    "author": "RICTMS Team",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "node scripts/prepare-dev.js && nest start --watch",
        "start:gateway": "nest start --entryFile apps/gateway.main",
        "start:gateway:dev": "nest start --entryFile apps/gateway.main --watch",
        "start:users": "nest start --entryFile apps/users-service.main",
        "start:users:dev": "nest start --entryFile apps/users-service.main --watch",
        "start:ticketing": "nest start --entryFile apps/ticketing-service.main",
        "start:ticketing:dev": "nest start --entryFile apps/ticketing-service.main --watch",
        "start:compliance": "nest start --entryFile apps/compliance-service.main",
        "start:compliance:dev": "nest start --entryFile apps/compliance-service.main --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "db:create": "node -e \"require('child_process').exec('mysql -u root -p < src/database/init.sql', (err, stdout, stderr) => { if (err) console.error(err); else console.log('Database created'); })\"",
        "db:schema": "node -e \"require('child_process').exec('mysql -u root -p compliance_hub < src/database/schema.sql', (err, stdout, stderr) => { if (err) console.error(err); else console.log('Schema applied'); })\"",
        "db:seed": "ts-node src/database/seed.ts"
    },
    "dependencies": {
        "@nestjs/bull": "^10.0.1",
        "@nestjs/common": "^10.3.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.3.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/mapped-types": "^2.1.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.3.0",
        "@nestjs/schedule": "^6.1.1",
        "@nestjs/swagger": "^7.4.2",
        "@nestjs/typeorm": "^10.0.1",
        "bcrypt": "^5.1.1",
        "bull": "^4.12.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "diff-match-patch": "^1.0.5",
        "express-rate-limit": "^8.2.1",
        "google-auth-library": "^9.15.1",
        "helmet": "^7.1.0",
        "http-proxy-middleware": "^3.0.3",
        "joi": "^18.0.2",
        "mammoth": "^1.6.0",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.7.1",
        "nodemailer": "^8.0.4",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pdf-parse": "^1.1.1",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "^0.3.19",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.3.0",
        "@nestjs/schematics": "^10.1.0",
        "@nestjs/testing": "^10.3.0",
        "@types/bcrypt": "^5.0.2",
        "@types/diff-match-patch": "^1.0.36",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.0",
        "@types/nodemailer": "^7.0.11",
        "@types/passport-jwt": "^4.0.0",
        "@types/pdf-parse": "^1.1.5",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^29.7.0",
        "prettier": "^3.2.4",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.4",
        "ts-jest": "^29.1.1",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
