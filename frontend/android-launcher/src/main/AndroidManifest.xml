<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.vivo.notification.permission.BADGE_ICON" />
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" />
    <uses-permission android:name="com.hihonor.android.launcher.permission.CHANGE_BADGE" />

    <queries>
        <package android:name="com.vivo.launcher" />
        <package android:name="com.bbk.launcher2" />
        <package android:name="com.bbk.launcher3" />
        <package android:name="com.bbk.launcher" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/hub_launcher"
        android:label="@string/hub_app_name"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"
        android:usesCleartextTraffic="false">
        <meta-data android:name="asset_statements" android:resource="@string/hub_asset_statements" />
        <meta-data android:name="firebase_messaging_installation_id_enabled" android:value="true" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/hub_notification" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/fo2_icare_notification_color" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="@string/fo2_icare_notification_channel_id" />
        <activity
            android:name=".CertificateSetupActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/hub_launch_url" />
        </activity>
        <activity
            android:name="com.google.androidbrowserhelper.trusted.FocusActivity"
            android:exported="false" />
        <activity
            android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity"
            android:exported="false" />
        <activity
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:enabled="false"
            android:exported="false" />
        <service
            android:name=".HubNotificationService"
            android:exported="true">
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/hub_notification" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <service
            android:name=".FcmMessageService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name=".UnreadBadgeWidget"
            android:exported="false"
            android:label="@string/unread_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/unread_badge_widget" />
        </receiver>
        <provider
            android:name=".NotificationSoundProvider"
            android:authorities="${applicationId}.notification-sounds"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
