# Keep Codex context aligned with repository-local ignore policy
*.sql
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.png
*.md
!AGENTS.md
!CAPABILITIES.md
!CHANGELOG.md
!INSTALLATION.md
!MAIN-SYSTEM-DOCUMENTATION.md
!MASTER-CONTEXT.md
!README.md
!SECURITY.md
!SETUP.md
!WALKTHROUGH.md
*test*
*smoke*
*regression*
*fix*
*restore*
*seed*
!scripts/
!scripts/**/*
scripts/*.sql
Compliance_Hub_Postman_Collection.json

# Disposable test-only folders
frontend/tests/
backend/test/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
logs/
*.log

# Ignore only generated PDFs
frontend/**/*.pdf
backend/**/*.pdf

# Ignore only generated images
frontend/test-results/**/*.png
**/debug-*.png

# Keep important context docs visible
!MASTER-CONTEXT.md
!AGENTS.md
docker-compose.staging.yml

# Automatically loaded local-only Docker transport settings; never deploy these.
/docker-compose.override.yml

# Tests and Playwright runner files are local-only and must not be committed.
**/*.spec.ts
**/*.spec.tsx
**/*.test.ts
**/*.test.tsx
frontend/tests/
frontend/playwright*.ts
frontend/scripts/run-e2e-loop.mjs
frontend/scripts/run-visible-e2e-loop.ps1

# Local-only test runners under the otherwise tracked scripts directory.
scripts/*test*
scripts/*smoke*
scripts/*regression*
scripts/simulate-sqa.*

# Version the project context library, including paths matched by broad rules above.
!/context/
!/context/**/
!/context/**/*.md
!/context/tools/validate-context.mjs

# Generated audit records and disposable diagnostics stay local-only.
/context/audits/
/backend/audit.json
/frontend/audit.json
/ddos-report.json
/frontend/ddos-report.json
/frontend/lint-report.txt
/output/
/ppt-output/
/tmp/
