# Standard Node.js & general ignores
node_modules/
dist/
build/
coverage/
logs/
storage/
temp/
uploads/
.DS_Store
*.log
.env
.env*
.env*.local

# Ignore any folder starting with '.' that is not used by docker building
.*/

# Ignore specific extensions
*.png
*.sql

# Ignore all markdown files EXCEPT the ones specified
*.md
!AGENTS.md
!CAPABILITIES.md
!CHANGELOG.md
!INSTALLATION.md
!MAIN-SYSTEM-DOCUMENTATION.md
!MASTER-CONTEXT.md
!README.md
!SECURITY.md
!SETUP.md
!WALKTHROUGH.md

# Ignore specific folders
scratch/
frontend/test-results/
backend/test/

# Ignore files containing specific keywords
*test*
*smoke*
*regression*
*fix*
*restore*
*seed*

# EXCEPTION: Do not ignore anything from scripts folder
!scripts/
!scripts/**/*

Compliance_Hub_Postman_Collection.json
